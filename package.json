{
  "name": "cirro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun tooling/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run build && bun run typecheck && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && bun test",
    "dev": "bun run build && alchemy dev alchemy.run.ts --stage dev",
    "deploy": "bun run build && alchemy deploy alchemy.run.ts --stage prod",
    "bench": "bun tooling/benchmark.ts",
    "format": "oxfmt . && cargo fmt --all",
    "format:check": "oxfmt --check . && cargo fmt --all -- --check"
  },
  "dependencies": {
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@effect/platform-bun": "4.0.4",
    "@effect/platform-node": "4.0.4",
    "@types/bun": "1.4.2",
    "miniflare": "5.20261006.1-alpha",
    "oxfmt": "0.71.0",
    "typescript": "6.0.3"
  }
}
