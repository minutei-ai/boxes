{
  "name": "@minutei-ai/boxes",
  "version": "0.16.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/minutei-ai/boxes.git"
  },
  "files": [
    "dist/sdk",
    "LICENSE",
    "README.md",
    "docs/sdk.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/sdk/sdk.d.ts",
      "import": "./dist/sdk/sdk.js"
    },
    "./contracts": {
      "types": "./dist/sdk/contracts.d.ts",
      "import": "./dist/sdk/contracts.js"
    },
    "./rpc": {
      "types": "./dist/sdk/sdk-rpc.d.ts",
      "import": "./dist/sdk/sdk-rpc.js"
    },
    "./tanstack": {
      "types": "./dist/sdk/sdk-tanstack.d.ts",
      "import": "./dist/sdk/sdk-tanstack.js"
    }
  },
  "scripts": {
    "build": "bun tooling/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=2",
    "check": "bun run build && bun run build:sdk && bun run typecheck && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && bun run test",
    "dev": "bun run build && alchemy dev alchemy.run.ts --stage dev --profile minutei",
    "deploy": "bun run build && alchemy deploy alchemy.run.ts --stage prod --profile minutei",
    "bench": "bun tooling/benchmark.ts",
    "bench:metadata": "bun tooling/metadata-benchmark.ts",
    "bench:output": "bun tooling/output-benchmark.ts",
    "live": "bun tooling/live.ts",
    "software:proof": "bun tooling/software-proof.ts",
    "wasm:proof": "bun tooling/large-wasm-proof.ts",
    "import:proof": "bun tooling/import-proof.ts",
    "ownership:proof": "bun tooling/ownership-proof.ts",
    "advice:proof": "bun tooling/advice-proof.ts",
    "host-stat:proof": "bun tooling/host-stat-proof.ts",
    "fd-dup:proof": "bun tooling/fd-dup-proof.ts",
    "guest-spawn:proof": "bun tooling/guest-spawn-proof.ts",
    "signal-mask:proof": "bun tooling/signal-mask-proof.ts",
    "handlers:proof": "bun tooling/handlers-proof.ts",
    "signals:proof": "bun tooling/signals-proof.ts",
    "groups:proof": "bun tooling/groups-proof.ts",
    "recovery:proof": "bun tooling/recovery-proof.ts",
    "stdin:proof": "bun tooling/stdin-proof.ts",
    "exec:proof": "bun tooling/exec-proof.ts",
    "cwd:proof": "bun tooling/cwd-proof.ts",
    "inherited-pipe:proof": "bun tooling/inherited-pipe-proof.ts",
    "wasi-child:proof": "bun tooling/wasi-child-proof.ts",
    "wasi-slices:proof": "bun tooling/wasi-slices-proof.ts",
    "pipe:proof": "bun tooling/pipe-proof.ts",
    "format": "oxfmt . && cargo fmt --all && rustfmt tests/fixtures/*.rs",
    "format:check": "oxfmt --check . && cargo fmt --all -- --check && rustfmt --check tests/fixtures/*.rs",
    "plan": "bun run build && alchemy plan alchemy.run.ts --stage prod --profile minutei --no-input",
    "export:proof": "bun tooling/export-proof.ts",
    "bench:wasi": "cargo run -p boxes-wasm-bench --release --locked --",
    "build:sdk": "bun tooling/build-sdk.ts",
    "pack:runtime": "bun tooling/package-runtime.ts",
    "package:proof": "bun tooling/package-proof.ts",
    "prepack": "bun run build:sdk",
    "sdk:proof": "bun tooling/sdk-proof.ts",
    "timestamps:proof": "bun tooling/timestamps-proof.ts",
    "rights:proof": "bun tooling/rights-proof.ts",
    "stdio:proof": "bun tooling/raw-stdio-proof.ts",
    "shell:binary:proof": "bun tooling/binary-shell-proof.ts",
    "guest-work:proof": "bun tooling/guest-work-proof.ts",
    "dispose:proof": "bun tooling/dispose-proof.ts",
    "restore:proof": "bun tooling/restore-proof.ts",
    "cron:proof": "bun tooling/cron-proof.ts",
    "minutei:proof": "bun tooling/minutei-proof.ts",
    "binding:remote:proof": "bun tooling/remote-binding-proof.ts",
    "reclaim:proof": "bun tooling/reclamation-proof.ts"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.83",
    "@cloudflare/workers-types": "5.20261003.1",
    "@effect/platform-bun": "4.0.4",
    "@effect/platform-node": "4.0.4",
    "@tanstack/ai-code-mode": "0.5.2",
    "@types/bun": "1.4.2",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.4",
    "oxfmt": "0.71.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@tanstack/ai-code-mode": "^0.5.2",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/ai-code-mode": {
      "optional": true
    }
  },
  "patchedDependencies": {
    "@alchemy.run/cloudflare-runtime@2.0.0-beta.83": "patches/@alchemy.run%2Fcloudflare-runtime@2.0.0-beta.83.patch"
  }
}
